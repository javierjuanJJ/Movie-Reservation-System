# ===================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ===================================
# Entorno de ejecución
NODE_ENV=production

# Puerto en el que correrá la API
# Debe coincidir con el puerto expuesto en Docker
PORT=3000

# ===================================
# BASE DE DATOS (PostgreSQL)
# ===================================
# URL de conexión a PostgreSQL para Prisma
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos?schema=public
# En docker-compose, usar 'db' como host (nombre del servicio)
DATABASE_URL=postgresql://postgres:postgres@db:5432/movie_reservation?schema=public

# Configuración para el servicio PostgreSQL (usado por docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=movie_reservation

# ===================================
# BETTER AUTH (Autenticación)
# ===================================
# Clave secreta para firmar y verificar tokens de sesión
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-change-this-in-production

# URL base de tu aplicación
# Debe coincidir con la URL desde donde se accede a la API
BETTER_AUTH_URL=http://localhost:3000

# ===================================
# EMAIL (Resend)
# ===================================
# API Key de Resend para envío de correos electrónicos
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Correo electrónico desde el cual se envían los emails
# Debe estar verificado en Resend
EMAIL_FROM=noreply@yourdomain.com

# ===================================
# PAGOS (Stripe)
# ===================================
# Clave secreta de Stripe
# Obtener en: https://dashboard.stripe.com/apikeys
# Usar clave de test para desarrollo
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Secreto para verificar webhooks de Stripe
# Obtener al configurar webhook en Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===================================
# SMS (Twilio)
# ===================================
# SID de tu cuenta de Twilio
# Obtener en: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here

# Token de autenticación de Twilio
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Número de teléfono de Twilio desde el cual se envían SMS
# Formato: +1234567890
TWILIO_PHONE_NUMBER=+1234567890

# ===================================
# SEGURIDAD Y CORS (Opcionales)
# ===================================
# Orígenes permitidos para CORS (separados por coma si son múltiples)
# Ejemplo: http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Límite de peticiones por ventana de tiempo (requests por 15 minutos)
# Por defecto en el código es 100, se puede sobrescribir si se configura
RATE_LIMIT_MAX=100
